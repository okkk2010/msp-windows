* text=auto

# Keep Windows-style line endings for VS/.NET files
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.config text eol=crlf
*.cs text eol=crlf
*.resx text eol=crlf
*.Designer.cs text eol=crlf

# Scripts
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.bmp binary
*.dll binary
*.exe binary
*.pdb binary
*.zip binary
