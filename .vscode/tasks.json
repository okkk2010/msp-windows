{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/msp-windows/msp-windows.csproj",
                "-c",
                "Debug",
                "-p:Platform=AnyCPU"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/msp-windows/msp-windows.csproj",
                "-c",
                "Release",
                "-p:Platform=AnyCPU"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/msp-windows/msp-windows.csproj",
                "-c",
                "Debug",
                "-p:Platform=AnyCPU"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}
